{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["ES2018", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "build/ts-out",
    "rootDir": "src/scripts",
    "removeComments": true,
    "newLine": "lf"
  },
  "include": ["src/scripts/**/*.ts"]
}
